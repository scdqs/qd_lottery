version: '3.8'

services:
  backend:
    image: qd_lottery-backend:latest
    container_name: lottery-backend
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
      - PORT=3000
      - CORS_ORIGIN=https://your-pc-domain.com,https://your-h5-domain.com,https://your-api-domain.com
      - WECHAT_APP_ID=your_wechat_app_id
      - WECHAT_APP_SECRET=your_wechat_app_secret
      - WECHAT_REDIRECT_URI=https://your-api-domain.com/api/wechat/callback
      - H5_BASE_URL=https://your-h5-domain.com
    restart: unless-stopped
    networks:
      - lottery-network

  web-client:
    image: qd-web-client:latest
    container_name: lottery-web
    ports:
      - "3001:80"
    depends_on:
      - backend
    restart: unless-stopped
    networks:
      - lottery-network

  h5-client:
    image: qd-h5-client:latest
    container_name: lottery-h5
    ports:
      - "3002:80"
    depends_on:
      - backend
    restart: unless-stopped
    networks:
      - lottery-network

networks:
  lottery-network:
    driver: bridge
